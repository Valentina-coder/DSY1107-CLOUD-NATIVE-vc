# Copy to .env and fill in the endpoint and credentials from AWS Secrets Manager
# or another secure local secret store. Never commit the populated .env file.
SPRING_DATASOURCE_URL=jdbc:postgresql://<rds-endpoint>:5432/stock360?sslmode=require
SPRING_DATASOURCE_DRIVER=org.postgresql.Driver
SPRING_DATASOURCE_USERNAME=<database-user>
SPRING_DATASOURCE_PASSWORD=<database-password>
SPRING_JPA_HIBERNATE_DDL_AUTO=update
